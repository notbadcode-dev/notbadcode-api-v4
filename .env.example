# --- CORS ---
CORS_ORIGINS=http://localhost:3000  # Lista separada por comas de orígenes permitidos

# --- Rate Limiting ---
THROTTLE_TTL=60000     # Ventana de tiempo en milisegundos (60s)
THROTTLE_LIMIT=60      # Máximo de peticiones por ventana

# --- SSL (rutas dentro del contenedor) ---
SSL_KEY_PATH=/app/certs/dev-key.pem
SSL_CERT_PATH=/app/certs/dev-cert.pem

# --- Redis: dos instancias separadas (sesión y caché) ---
REDIS_SESSION_URL=redis://:SESSION_PASSWORD@redis-session-dev:6379/0
REDIS_SESSION_PASSWORD= # <--- Pon aquí la contraseña de la instancia de sesión (ejemplo: 6900)
REDIS_CACHE_URL=redis://:CACHE_PASSWORD@redis-cache-dev:6379/0
REDIS_CACHE_PASSWORD=   # <--- Pon aquí la contraseña de la instancia de caché (ejemplo: 6900)

# --- Base de datos (MariaDB) ---
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=       # <--- Contraseña del root de MariaDB (ejemplo: 6900)
DB_USER=                # <--- Usuario de base de datos (ejemplo: bgr)
DB_PASSWORD=            # <--- Contraseña del usuario (ejemplo: 6900)
DB_NAME=                # <--- Nombre de la base de datos (ejemplo: mysql)

# --- i18n (ajusta según perfil) ---
I18N_DIR=/app/libs/common/src/i18n
FALLBACK_LANGUAGE=en    # es | en | etc.
