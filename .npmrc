# ==== Shell por defecto para scripts (evita ENOENT con VS Code) ====
script-shell=/bin/zsh

# ==== Seguridad y comportamiento predecible ====
save-exact=true                 # Guarda versiones exactas en package.json (sin ^ ni ~)
engine-strict=true              # Obliga a usar las versiones de Node definidas en "engines"
audit=true                      # Habilita npm audit por defecto
fund=false                      # Desactiva mensajes de donaciones

# ==== Instalaciones rápidas y coherentes ====
prefer-offline=true             # Usa cache local siempre que se pueda
progress=false                  # Quita barra de progreso para instalaciones más rápidas
legacy-peer-deps=false          # Respetar peerDependencies (mejor para NestJS v11)
strict-peer-deps=false          # Si quieres que falle si no coinciden (pon a true si buscas más control)

# ==== Cache y logs ====
cache=/Users/bgr/.npm-cache     # Ruta fija de cache (puede ayudar en CI/CD y con nvm)
logs-max=10                     # Mantener pocos logs

# ==== Configuración de registro ====
registry=https://registry.npmjs.org/
