{
  "name": "notbadcode-api-v4",
  "version": "0.0.1",
  "private": true,
  "description": "API monorepo NestJS v4",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "build:auth": "nest build auth",
    "build:clean": "rimraf dist && npm run build",
    "certs:generate": "cd certs && chmod +x generate-dev-cert.sh && ./generate-dev-cert.sh",
    "certs:validate": "cd certs && openssl x509 -in dev-cert.pem -text -noout && openssl pkey -in dev-key.pem -noout -text && openssl x509 -noout -modulus -in dev-cert.pem | openssl md5 && openssl pkey -noout -modulus -in dev-key.pem | openssl md5 && openssl verify -CAfile dev-cert.pem dev-cert.pem",
    "docker:build": "docker compose build",
    "docker:build:auth": "docker compose build auth",
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:logs:debug": "docker compose --profile debug logs -f",
    "docker:logs:prod": "docker compose --profile prod logs -f",
    "docker:prune": "docker system prune -f --volumes",
    "docker:ps": "docker compose ps",
    "docker:up": "docker compose up -d",
    "docker:up:auth": "docker compose up -d auth",
    "docker:up:debug": "docker compose --profile debug up -d --build",
    "docker:up:prod": "docker compose --profile prod up -d --build",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "health": "curl -fsS http://localhost:60200/healthz || (echo 'API KO' && exit 1)",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix --cache --cache-location .eslintcache",
    "node": "nvm use 22.14",
    "start": "nest start",
    "start:auth": "nest start auth",
    "start:auth:debug": "nest start auth --debug 0.0.0.0:9229 --watch",
    "start:auth:dev": "nest start auth --watch",
    "start:dev": "nest start --watch",
    "test": "npx jest --config jest.config.js",
    "test:auth": "npx jest --config apps/auth/test/jest.config.js",
    "test:common": "npx jest --config libs/common/test/jest.config.js",
    "test:cov": "npx jest --coverage --config jest.config.js",
    "test:cov:auth": "npx jest --coverage --config apps/auth/test/jest.config.js",
    "test:cov:common": "npx jest --coverage --config libs/common/test/jest.config.js",
    "test:watch": "npx jest --watch --config jest.config.js",
    "test:watch:auth": "npx jest --watch --config apps/auth/test/jest.config.js",
    "test:watch:common": "npx jest --watch --config libs/common/test/jest.config.js",
    "tree": "tree -I 'node_modules|dist|coverage|.git'"
  },
  "dependencies": {
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.1.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "11.0.0",
    "bcrypt": "^5.1.1",
    "cache-manager": "7.1.1",
    "cache-manager-redis-yet": "5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "i18next": "^25.3.2",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.8.0",
    "joi": "^18.0.0",
    "mysql": "^2.18.1",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "10.5.1",
    "open": "^10.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.25",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "chokidar-cli": "^3.0.0",
    "cpy-cli": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "29.4.1",
    "jest-mock-extended": "4.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  }
}